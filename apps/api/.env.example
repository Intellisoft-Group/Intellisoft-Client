DATABASE_URL=postgresql://intellisoft:intellisoft@127.0.0.1:5433/intellisoft?schema=public
JWT_SECRET=intellisoft-dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=intellisoft-dev-refresh-secret-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional; falls back to JWT_SECRET in non-production
CAPTCHA_SECRET=
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
# Invoice pay links use API_PUBLIC_URL, e.g. http://localhost:3000/pay/<token>
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081
# Client web portal origin (password-reset emails, etc.)
CLIENT_APP_URL=http://localhost:3002
UPLOAD_DIR=uploads

# --- Production checklist (Hostinger / VPS + Cloudflare) ---
# NODE_ENV=production
# Require strong JWT_SECRET + JWT_REFRESH_SECRET (boot fails without them)
# DATABASE_URL=postgresql://...
# API_PUBLIC_URL=https://api-client.theintellisoft.com
# CLIENT_APP_URL=https://client.theintellisoft.com
# CORS_ORIGINS=https://cms-client.theintellisoft.com,https://client.theintellisoft.com,http://cms-client.theintellisoft.com,http://client.theintellisoft.com
# Cloudflare Flexible SSL; nginx on VPS stays :80
# Do NOT run prisma:seed / prisma:reset on production (demo passwords)
# Android release BuildConfig.API_URL must use https://api-client.theintellisoft.com

# Firebase Cloud Messaging (HTTP v1 — new Firebase console)
# Project settings → Service accounts → Generate new private key
# FCM_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-adminsdk.json
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Legacy (often missing in new consoles):
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Intellisoft <chief@theintellisoft.com>
