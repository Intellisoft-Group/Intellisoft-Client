{
  "name": "intellisoft-client-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Intellisoft client portal, staff CMS (Next.js), and NestJS API",
  "workspaces": [
    "apps/api",
    "apps/cms",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@intellisoft/api",
    "dev:cms": "npm run dev --workspace=@intellisoft/cms",
    "dev:web": "npm run dev --workspace=@intellisoft/web",
    "dev:stack": "echo Start: npm run dev:api, npm run dev:cms, npm run dev:web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "npm run db:up && npm run db:migrate",
    "db:migrate": "npm run prisma:migrate --workspace=@intellisoft/api",
    "db:seed": "npm run prisma:seed --workspace=@intellisoft/api",
    "db:reset": "npm run prisma:reset --workspace=@intellisoft/api",
    "build:api": "npm run build --workspace=@intellisoft/api",
    "build:cms": "npm run build --workspace=@intellisoft/cms",
    "build:web": "npm run build --workspace=@intellisoft/web",
    "deploy:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "deploy:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "deploy:prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "deploy:backup": "bash deploy/backup.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.15"
  },
  "overrides": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3"
  }
}
