POSTGRES_USER=intellisoft
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=intellisoft

JWT_SECRET=replace-with-64-char-random
JWT_REFRESH_SECRET=replace-with-another-64-char-random
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

API_PORT=3000
# Public HTTPS URLs (Cloudflare Flexible → origin HTTP :80). Baked into CMS/portal at Docker build.
API_PUBLIC_URL=https://api-client.theintellisoft.com
CLIENT_APP_URL=https://client.theintellisoft.com
# Include both schemes so direct-origin and Cloudflare work during cutover.
CORS_ORIGINS=https://cms-client.theintellisoft.com,https://client.theintellisoft.com,http://cms-client.theintellisoft.com,http://client.theintellisoft.com
UPLOAD_DIR=uploads
NODE_ENV=production

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=chief@theintellisoft.com
SMTP_PASS=
SMTP_FROM=Intellisoft <chief@theintellisoft.com>

# Firebase Cloud Messaging (HTTP v1)
# Place secrets/firebase-adminsdk.json on the VPS (mounted at /app/secrets).
FCM_SERVICE_ACCOUNT_PATH=/app/secrets/firebase-adminsdk.json
FCM_SERVER_KEY=

# CMS + client portal NEXT_PUBLIC_API_URL is baked at Docker build from API_PUBLIC_URL above.
# Deploy with: npm run deploy:prod  (uses --env-file .env.production)
#
# Domains (single-level subdomains — Free Cloudflare SSL covers *.theintellisoft.com):
#   Portal: https://client.theintellisoft.com
#   API:    https://api-client.theintellisoft.com
#   CMS:    https://cms-client.theintellisoft.com
# Payments: bank / cash / cheque only (no Razorpay/Stripe)
#
# Cloudflare setup:
#   1) A records: api-client, cms-client, client → VPS IP (orange-cloud)
#   2) SSL/TLS mode = Flexible
#   3) Keep API_PUBLIC_URL / CLIENT_APP_URL as https://… (required for browsers + Android)
#   4) Rebuild CMS/web after any API_PUBLIC_URL change
# Do NOT use api.client / cms.client — Free SSL does not cover deep subdomains.
