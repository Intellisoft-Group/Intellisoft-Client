# Copy to apps/api/.env and apps/cms/.env.local for local development.

# --- API (apps/api/.env) ---
DATABASE_URL=postgresql://intellisoft:intellisoft@127.0.0.1:5432/intellisoft?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
CAPTCHA_SECRET=change-me-to-a-captcha-hmac-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
API_PORT=3000
API_PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001
UPLOAD_DIR=uploads
NODE_ENV=development

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Intellisoft <chief@theintellisoft.com>
CLIENT_APP_URL=http://localhost:3001

# --- CMS (apps/cms/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Android client (apps/android) ---
# Debug: http://127.0.0.1:3000 with adb reverse tcp:3000 tcp:3000
# Release: gradlew assembleRelease -PAPI_URL=https://api-client.theintellisoft.com

# --- Production (Cloudflare HTTPS) ---
# See .env.production.example and deploy/hostinger.md
# API_PUBLIC_URL=https://api-client.theintellisoft.com
# CLIENT_APP_URL=https://client.theintellisoft.com
# Payments: bank / cash / cheque only
